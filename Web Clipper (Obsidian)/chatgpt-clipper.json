{
	"schemaVersion": "0.1.0",
	"name": "ChatGPT",
	"behavior": "overwrite",
	"noteContentFormat": "{{selectorHtml:*:is([data-user-message-bubble],[data-markdown-text-style=assistant-message])|join:\"\"|replace:(\"<div data-user-message-bubble\":\"<h1>Hai detto:</h1><div data-user-message-bubble\",\"<div data-selected-text-overlay-target\":\"<h1>ChatGPT ha detto:</h1><div data-selected-text-overlay-target\")|markdown}}",
	"properties": [
		{
			"name": "URL",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\\\", \\\"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "source/AI",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://chatgpt.com/share",
		"https://chatgpt.com/c"
	],
	"noteNameFormat": "{{title}}",
	"path": "Sources/AI"
}